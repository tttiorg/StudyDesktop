{
  "name": "study-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "学习桌面 - 课程、资料与文件管理",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "cn.study.desktop",
    "productName": "StudyDesktop",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/vite/**",
      "!node_modules/@vitejs/**",
      "!node_modules/rollup/**",
      "!node_modules/rolldown/**",
      "!node_modules/@rolldown/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "学习桌面",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "element-plus": "^2.14.7",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  }
}
